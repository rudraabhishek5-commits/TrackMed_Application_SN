        <messages/>
        <name>Presentation Random Alert Pop</name>
        <order/>
        <script><![CDATA[function onLoad() {
    // 1. SET THE TIME DELAY (in milliseconds)
    // Change 10000 (10 seconds) to whatever timing fits your presentation speech!
    var delayTime = 10000;

    setTimeout(triggerFakeNotification, delayTime);

    function triggerFakeNotification() {
        // 2. THE CHOSEN RANDOM POPUP QUESTION
        var message = "⚠️ URGENT MEDICATION REMINDER:\n\nYou need to give the scheduled medicine to Patient: John Doe right now.\n\nDid the patient take the medicine?\n\nType 'YES' if taken.\nType 'NO' if not taken.";

        var userResponse = prompt(message);

        // If user clicks Cancel or leaves it empty
        if (userResponse === null) {
            return;
        }

        // 3. IF THE USER CHOOSES 'YES' (TAKEN)
        if (userResponse.toUpperCase() === 'YES') {
            g_form.clearMessages();
            g_form.addInfoMessage("✅ **[Success]** Dose marked as 'Taken'. Daily tracking log updated successfully.");
        }

        // 4. IF THE USER CHOOSES 'NO' (NOT TAKEN) -> FORCE NOTES
        else if (userResponse.toUpperCase() === 'NO') {
            var notes = prompt("⚠️ REASON REQUIRED:\n\nPlease enter the notes/reason why the medicine was not taken:");

            if (notes === null || notes.trim() === "") {
                alert("Notes cannot be empty. Action aborted.");
                // Re-trigger the notes popup if they tried to skip it
                triggerFakeNotification();
            } else {
                g_form.clearMessages();
                g_form.addErrorMessage("❌ **[Alert]** Dose marked as 'Not-taken'. Notes recorded: \"" + notes + "\". Notification dispatched to Guardian.");
            }
        }

        // If they type something else entirely
        else {
            alert("Invalid response. Please type YES or NO.");
            triggerFakeNotification();
        }
    }
}]]></script>
