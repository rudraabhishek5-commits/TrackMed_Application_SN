        <name>TrackMed Create Patient Modal</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {

    if(input && input.action == 'createPatient') {

        var gr = new GlideRecord('x_trackmed_patient');

        gr.initialize();

        gr.u_first_name =
            input.patient.first_name;

        gr.u_last_name =
            input.patient.last_name;

        gr.u_gender =
            input.patient.gender;

        gr.u_phone =
            input.patient.phone;

        gr.u_email =
            input.patient.email;

        gr.u_address =
            input.patient.address;

        gr.u_status = 'Active';

        gr.insert();

    }

})();]]></script>
