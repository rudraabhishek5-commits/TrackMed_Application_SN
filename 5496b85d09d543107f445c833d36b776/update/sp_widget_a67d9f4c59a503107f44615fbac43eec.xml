        <css>/* ECG container */
.ecg-bg-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.ecg-track {
  position: absolute;
  width: 200%;
  left: 0;
}

.ecg-track svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* 3 lines clustered at vertical center */
.ecg-track-1 {
  top: 35%;
  height: 80px;
  animation: ecgScroll 14s linear infinite;
}

.ecg-track-2 {
  top: 50%;
  height: 60px;
  animation: ecgScroll 18s linear infinite 2s;
}

.ecg-track-3 {
  top: 62%;
  height: 40px;
  animation: ecgScroll 22s linear infinite 5s;
}

@keyframes ecgScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* Keep all page content above ECG */
.trackmed-landing .nav,
.trackmed-landing header,
.trackmed-landing section,
.trackmed-landing footer {
  position: relative;
  z-index: 1;
}</css>
