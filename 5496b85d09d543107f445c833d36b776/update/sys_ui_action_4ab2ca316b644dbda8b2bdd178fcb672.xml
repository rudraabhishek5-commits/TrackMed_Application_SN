        <name>Adherence</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[var patientId = current.sys_id.toString();

var totalAgg = new GlideAggregate('x_snc_trackmed_dose_log');
totalAgg.addQuery('patient', patientId);
totalAgg.addAggregate('COUNT');
totalAgg.query();
var totalCount = 0;
if (totalAgg.next()) {
    totalCount = parseInt(totalAgg.getAggregate('COUNT'), 10);
}

var takenAgg = new GlideAggregate('x_snc_trackmed_dose_log');
takenAgg.addQuery('patient', patientId);
takenAgg.addQuery('status', 'Taken');
takenAgg.addAggregate('COUNT');
takenAgg.query();
var takenCount = 0;
if (takenAgg.next()) {
    takenCount = parseInt(takenAgg.getAggregate('COUNT'), 10);
}

var adherence = 0;
if (totalCount > 0) {
    adherence = Math.round((takenCount / totalCount) * 100);
}

gs.addInfoMessage('Adherence: ' + adherence + '% (' + takenCount + ' taken out of ' + totalCount + ' total dose logs)');
action.setRedirectURL(current);]]></script>
