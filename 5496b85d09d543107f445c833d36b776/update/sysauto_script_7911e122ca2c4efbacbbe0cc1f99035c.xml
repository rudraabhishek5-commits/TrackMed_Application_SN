        <script><![CDATA[(function () {
    try {
        var oneMonthAgo = new GlideDateTime();
        oneMonthAgo.addMonthsLocalTime(-1);

        var gr = new GlideRecord('x_snc_trackmed_dose_log');
        gr.addQuery('sys_created_on', '<', oneMonthAgo);
        gr.query();

        var count = 0;
        while (gr.next()) {
            gr.deleteRecord();
            count++;
        }

        gs.info('Auto-Delete Old Dose Logs: Deleted ' + count + ' dose log records older than 1 month.');
    } catch (e) {
        gs.error('Auto-Delete Old Dose Logs failed: ' + e.message);
    }
})();
]]></script>
